[Unit]
Description=LumenLocal FastAPI backend
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=lumenlocal
Group=lumenlocal
WorkingDirectory=/opt/lumenlocal/backend
EnvironmentFile=/opt/lumenlocal/backend/.env
ExecStart=/opt/lumenlocal/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
