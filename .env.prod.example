# Public VPS deploy env. On the server: copy to .env and fill in real values.
#   cp .env.prod.example .env  &&  nano .env
# Generate each secret with:  openssl rand -hex 32   (or `-base64 24` for passwords)
# NEVER commit the filled-in .env. See DEPLOY_MVP.md.

# ─── Public site ──────────────────────────────────────────────────────────────
# Your domain (its A record must point at this VPS before first start).
DOMAIN=demo.example.com
# Email Let's Encrypt uses for cert expiry notices.
ACME_EMAIL=you@example.com

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=LumenLocal
ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=https://demo.example.com
ALLOWED_ORIGINS=["https://demo.example.com"]

# REQUIRED — JWT signing key. Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── PostgreSQL — internal to the compose network (not published) ──────────────
POSTGRES_USER=lumen
# Strong superuser password. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=lumenlocal
# Strong password for the RLS-scoped app role; rotated to match by the migrate step.
APP_DB_PASSWORD=CHANGE_ME_strong_password

# ─── Redis — internal to the compose network (not published) ───────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Job / Queue ──────────────────────────────────────────────────────────────
JOBS_DEFAULT_QUEUE=default
JOBS_MAX_RETRIES=3
JOBS_RETRY_BACKOFF_MAX=600
JOBS_TENANT_CONCURRENCY=8
JOBS_FAIRNESS_RETRY_DELAY=5
JOBS_INFLIGHT_TTL_SECONDS=3600
JOBS_IDEMPOTENCY_TTL_SECONDS=86400
JOBS_DEAD_LETTER_KEY=jobs:dead_letter

# ─── Google OAuth (GBP) — placeholders; not exercised in the click-through demo ─
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-replace-with-real-secret
GOOGLE_OAUTH_REDIRECT_URI=https://demo.example.com/api/v1/auth/google/callback

# ─── Token Vault — empty = in-memory LocalDevVault stub ─────────────────────────
VAULT_URL=
VAULT_KV_PATH=secret/lumenlocal

# Demo login seed (used by scripts.seed_demo). Change before sharing.
DEMO_EMAIL=demo@lumenlocal.app
DEMO_PASSWORD=CHANGE_ME_demo_password
