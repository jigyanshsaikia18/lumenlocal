# Copy to .env at the repo root: `cp .env.example .env`
# docker-compose and the backend settings loader both read these.
# NEVER put real secrets in .env.example — placeholders only.

# ---- PostgreSQL 15 ----
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_dev_password
POSTGRES_DB=lumenlocal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy / app connection string (host = localhost when running uvicorn on host)
DATABASE_URL=postgresql+psycopg://lumen:lumen_dev_password@localhost:5432/lumenlocal

# ---- Redis 7 (Celery broker + result backend) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- App ----
ENVIRONMENT=development
