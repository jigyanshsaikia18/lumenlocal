# Copy to .env at the repo root: `cp .env.example .env`
# docker-compose and the backend settings loader both read these.
# NEVER put real secrets in .env.example — placeholders only.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=LumenLocal
ENVIRONMENT=development          # development | staging | production
DEBUG=false
FRONTEND_URL=http://localhost:3000
# JSON array — origins allowed for cross-origin API requests.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# REQUIRED ── JWT signing key. Startup fails with a clear ValidationError if unset.
# Generate: openssl rand -hex 32
# Never reuse across environments; rotate immediately if compromised.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── PostgreSQL 15 ────────────────────────────────────────────────────────────
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_dev_password
POSTGRES_DB=lumenlocal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Privileged connection — migrations / admin / health. Superuser in dev; BYPASSES RLS.
# Do NOT use for request handling. Use APP_DATABASE_URL instead.
DATABASE_URL=postgresql+psycopg://lumen:lumen_dev_password@localhost:5432/lumenlocal

# Application connection — non-superuser role subject to row-level security (P1A-2).
# All tenant-scoped runtime queries use this role. The role is provisioned by the
# tenant_isolation_rls migration; production sets its password via infra/secrets.
APP_DATABASE_URL=postgresql+psycopg://lumen_app:lumen_app_dev_password@localhost:5432/lumenlocal

# ─── Redis 7 (Celery broker + result backend) ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Job / Queue ──────────────────────────────────────────────────────────────
JOBS_DEFAULT_QUEUE=default
# Maximum retry attempts before a task goes to the dead-letter queue.
JOBS_MAX_RETRIES=3
# Ceiling for exponential-backoff retry delay, in seconds.
JOBS_RETRY_BACKOFF_MAX=600
# Max concurrent in-flight tasks per tenant (fairness cap — see 02_Technical_Architecture §8).
JOBS_TENANT_CONCURRENCY=8
# Seconds a fairness-yielded task waits before re-queuing.
JOBS_FAIRNESS_RETRY_DELAY=5
# Seconds before an in-flight slot is reclaimed after a worker crash.
JOBS_INFLIGHT_TTL_SECONDS=3600
# Seconds an idempotency key is kept (duplicate submissions in this window are suppressed).
JOBS_IDEMPOTENCY_TTL_SECONDS=86400
# Redis list key where exhausted-retry tasks are parked for inspection/replay.
JOBS_DEAD_LETTER_KEY=jobs:dead_letter

# ─── Google OAuth (GBP connection) ────────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# OAuth scope required: https://www.googleapis.com/auth/business.manage
#
# COMPLIANCE: raw tokens must NEVER be stored in the database.
# Call vault.set_secret(token) and persist only the returned opaque token_ref.
# See CLAUDE.md hard rules and ticket P1D-1 for the full vault wiring.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-replace-with-real-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── Token Vault ──────────────────────────────────────────────────────────────
# URL of the production secret store (HashiCorp Vault, AWS Secrets Manager, etc.).
# Leave empty in local development to use the in-memory LocalDevVault stub.
# Wire a real backend in ticket P1D-1.
VAULT_URL=
VAULT_KV_PATH=secret/lumenlocal
