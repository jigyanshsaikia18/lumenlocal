# Copy to .env at the repo root: `cp .env.example .env`
# docker-compose and the backend settings loader both read these.
# NEVER put real secrets in .env.example — placeholders only.

# ---- PostgreSQL 15 ----
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_dev_password
POSTGRES_DB=lumenlocal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Privileged connection — migrations / admin / health. Superuser in dev; BYPASSES RLS.
DATABASE_URL=postgresql+psycopg://lumen:lumen_dev_password@localhost:5432/lumenlocal

# Application connection — non-superuser role subject to row-level security (P1A-2).
# All tenant-scoped runtime queries use this role. The role is provisioned by the
# tenant_isolation_rls migration; production sets its password via infra/secrets.
APP_DATABASE_URL=postgresql+psycopg://lumen_app:lumen_app_dev_password@localhost:5432/lumenlocal

# ---- Redis 7 (Celery broker + result backend) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- App ----
ENVIRONMENT=development
